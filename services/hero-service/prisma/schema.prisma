generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hero {
  id         String   @id @default(uuid())
  externalId Int      @unique
  name       String
  imageUrl   String?
  winRate    Float?
  pickRate   Float?
  banRate    Float?
  syncedAt   DateTime @updatedAt

  @@map("heroes")
}
